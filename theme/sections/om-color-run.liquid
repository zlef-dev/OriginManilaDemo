{%- comment -%}
  Origin color run: one product per block; scrolling swaps the active colorway and the stage
  washes to that block's color (the sticky stage, not <body> — D-035). Sold-out colorways show the
  CLAIMED stamp from availability. Reduced motion / editor: a static grid of the same colorways.
{%- endcomment -%}

{{ 'om-cinema.css' | asset_url | stylesheet_tag }}
{{ 'om-color-run.css' | asset_url | stylesheet_tag }}
<script src="{{ 'om-color-run.js' | asset_url }}" type="module"></script>

{%- liquid
  assign count = section.blocks.size
  if count < 1
    assign count = 1
  endif
  assign per_desktop = section.settings.per_colorway_desktop
  assign per_mobile = section.settings.per_colorway_mobile
  assign length_desktop = count | times: per_desktop | plus: 100
  assign length_mobile = count | times: per_mobile | plus: 80
  assign first_block = section.blocks.first
-%}

<om-color-run
  class="om-scene om-color-run"
  style="--om-length-desktop: {{ length_desktop }}svh; --om-length-mobile: {{ length_mobile }}svh; --om-run-bg: {{ first_block.settings.color | default: settings.color_palette.color2 }};"
  data-count="{{ section.blocks.size }}"
>
  <div class="om-stage om-color-run__stage">
    <header class="om-color-run__header">
      {%- if section.settings.kicker != blank -%}
        <p class="om-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="om-display om-color-run__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </header>

    <ol class="om-color-run__slides" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign bg = block.settings.color | default: settings.color_palette.color2
          assign brightness = bg | color_brightness
          if brightness > 150
            assign ink = '#0a0a0b'
          else
            assign ink = '#f4f4f2'
          endif
          assign image = block.settings.image | default: product.featured_image
          assign label = block.settings.label | default: product.title
        -%}
        <li
          class="om-color-run__slide{% if forloop.first %} is-active{% endif %}"
          style="--om-slide-bg: {{ bg }}; --om-slide-ink: {{ ink }};"
          data-color="{{ bg }}"
          data-ink="{{ ink }}"
          {{ block.shopify_attributes }}
        >
          <div class="om-color-run__media">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 1400
                | image_tag:
                  widths: '400, 600, 900, 1200, 1400',
                  sizes: '(min-width: 990px) 40vw, 80vw',
                  loading: 'lazy',
                  alt: label
              }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'om-color-run__placeholder' }}
            {%- endif -%}
            {%- if product != blank -%}
              {% render 'om-product-status', product: product, context: 'media' %}
            {%- endif -%}
          </div>

          <div class="om-color-run__info">
            <span class="om-color-run__index om-kicker">
              {{- forloop.index | prepend: '0' | slice: -2, 2 }} / {{ section.blocks.size | prepend: '0' | slice: -2, 2 -}}
            </span>
            <h3 class="om-color-run__name">{{ label | escape }}</h3>
            {%- if product != blank -%}
              <p class="om-color-run__price">{{ product.price | money }}</p>
              {%- if product.available -%}
                <a class="om-cta om-color-run__cta" href="{{ product.url }}">{{ section.settings.button_label | escape }}</a>
              {%- else -%}
                <a class="om-color-run__claimed" href="{{ product.url }}">{{ section.settings.claimed_label | escape }}</a>
              {%- endif -%}
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.blocks.size > 1 -%}
      <div class="om-color-run__dots" aria-hidden="true">
        {%- for block in section.blocks -%}
          <span class="om-color-run__dot{% if forloop.first %} is-active{% endif %}" style="--om-dot: {{ block.settings.color | default: settings.color_palette.color2 }};"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</om-color-run>

{% schema %}
{
  "name": "Origin color run",
  "tag": "section",
  "class": "om-section om-section--color-run",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Concrete Jungle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your camo" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop this colorway" },
    { "type": "text", "id": "claimed_label", "label": "Sold-out link text", "default": "Claimed. See the piece" },
    { "type": "header", "content": "Scroll" },
    { "type": "range", "id": "per_colorway_desktop", "label": "Scroll per colorway, desktop", "min": 30, "max": 100, "step": 5, "unit": "vh", "default": 55 },
    { "type": "range", "id": "per_colorway_mobile", "label": "Scroll per colorway, mobile", "min": 30, "max": 80, "step": 5, "unit": "vh", "default": 45 }
  ],
  "blocks": [
    {
      "type": "colorway",
      "name": "Colorway",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "color", "id": "color", "label": "Stage color", "default": "#3a3a3a" },
        { "type": "text", "id": "label", "label": "Name override" },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Defaults to the product's featured image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Origin color run",
      "blocks": [
        { "type": "colorway", "settings": { "color": "#c8561c" } },
        { "type": "colorway", "settings": { "color": "#2f5a3c" } },
        { "type": "colorway", "settings": { "color": "#4a2d6e" } },
        { "type": "colorway", "settings": { "color": "#7fcdb3" } }
      ]
    },
    {
      "name": "Gemstones",
      "settings": { "kicker": "Gemstones", "heading": "Pick your stone" },
      "blocks": [
        { "type": "colorway", "settings": { "color": "#9b1b30" } },
        { "type": "colorway", "settings": { "color": "#1d5fa8" } },
        { "type": "colorway", "settings": { "color": "#e7a1b8" } },
        { "type": "colorway", "settings": { "color": "#e9e9ef" } }
      ]
    }
  ]
}
{% endschema %}
