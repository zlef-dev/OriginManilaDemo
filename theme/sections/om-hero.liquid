{%- comment -%}
  Origin hero: huge headline, chrome logo in front. Scroll = the logo recedes and floats up to
  reveal the headline + quote, holds, comes back, turns face-on and the camera flies through the
  logo's loop (D-029, D-096).
  - The headline is real text (the LCP element). The vector chrome logo is the static fallback and
    the first paint; WebGL replaces it after load + idle when the device can afford it, entering
    with one 360° turn.
  - Intro loader: the chrome logo spins 360° with a small counter, then a flash. CSS-timed, ≤1.5 s,
    once per session, any input skips it; never in the theme editor or with reduced motion (D-042).
{%- endcomment -%}

{{ 'om-cinema.css' | asset_url | stylesheet_tag }}
{{ 'om-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'om-hero.js' | asset_url }}" type="module"></script>

{%- liquid
  assign intro_ms = section.settings.intro_duration
  assign gradient_id = 'om-chrome-' | append: section.id
  assign use_3d = section.settings.enable_3d
  if request.design_mode
    assign show_intro = false
  else
    assign show_intro = section.settings.intro
  endif

  assign quote_words = section.settings.quote | split: ' '
  assign quote_accent = section.settings.quote_accent | downcase | strip
-%}

{%- if section.settings.quote_accent != blank and section.settings.quote != blank -%}
  {% style %}
    @font-face {
      font-family: 'OM Blackletter';
      src: url('{{ 'om-blackletter.woff2' | asset_url }}') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
  {% endstyle %}
{%- endif -%}

{%- if show_intro -%}
  <script>
    (function () {
      try {
        var root = document.documentElement;
        if (sessionStorage.getItem('om-intro-seen') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        sessionStorage.setItem('om-intro-seen', '1');
        root.classList.add('om-intro-on');
        var events = ['keydown', 'pointerdown', 'wheel', 'touchstart'];
        var end = function () {
          root.classList.remove('om-intro-on');
          events.forEach(function (name) { removeEventListener(name, end, true); });
        };
        events.forEach(function (name) { addEventListener(name, end, { capture: true, passive: true }); });
        setTimeout(end, {{ intro_ms | plus: 150 }});
      } catch (error) {}
    })();
  </script>
{%- endif -%}

<om-hero
  class="om-scene om-hero"
  style="--om-length-desktop: {{ section.settings.length_desktop }}svh; --om-length-mobile: {{ section.settings.length_mobile }}svh; --om-intro-ms: {{ intro_ms }}ms; --om-chrome: url(#{{ gradient_id }});"
  data-webgl="{{ use_3d }}"
  data-sparkles="{{ section.settings.sparkles }}"
  data-tilt="{{ section.settings.tilt | divided_by: 100.0 }}"
  data-logo-src="{{ 'logo.svg' | asset_url }}"
>
  {%- if section.settings.fallback_image == blank -%}
    <svg class="om-hero__gradient" aria-hidden="true" focusable="false" width="0" height="0">
      <defs>
        <linearGradient id="{{ gradient_id }}" x1="0" y1="0" x2="0.35" y2="1">
          <stop offset="0" stop-color="#fbfbfd"/>
          <stop offset="0.28" stop-color="#8b9099"/>
          <stop offset="0.46" stop-color="#f4f5f7"/>
          <stop offset="0.55" stop-color="#e3d7f2"/>
          <stop offset="0.64" stop-color="#5a5f68"/>
          <stop offset="0.82" stop-color="#dfe3ea"/>
          <stop offset="1" stop-color="#8e949c"/>
        </linearGradient>
      </defs>
    </svg>
  {%- endif -%}

  <div class="om-stage om-grain om-hero__stage">
    <div class="om-hero__title">
      <h1 class="om-display om-hero__headline">{{ section.settings.headline | escape }}</h1>
      {%- if section.settings.quote != blank -%}
        <p class="om-hero__quote">
          {%- for word in quote_words -%}
            {%- assign bare = word | downcase | remove: '.' | remove: ',' | remove: '!' -%}
            {%- if quote_accent != blank and bare == quote_accent -%}
              <span class="om-blackletter om-hero__quote-accent">{{ word | escape }}</span>
            {%- else -%}
              {{ word | escape }}
            {%- endif -%}
            {% unless forloop.last %} {% endunless %}
          {%- endfor -%}
        </p>
      {%- endif -%}
    </div>

    <div class="om-hero__logo">
      {%- if section.settings.fallback_image != blank -%}
        {{
          section.settings.fallback_image
          | image_url: width: 1800
          | image_tag:
            class: 'om-hero__vector',
            widths: '600, 900, 1200, 1800',
            sizes: '(min-width: 990px) 60vw, 86vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      {%- else -%}
        <div class="om-hero__vector" aria-hidden="true">{{ 'logo.svg' | inline_asset_content }}</div>
      {%- endif -%}
      {%- if use_3d -%}
        <canvas class="om-hero__canvas" aria-hidden="true"></canvas>
      {%- endif -%}
    </div>

    <div class="om-hero__meta">
      {%- if section.settings.kicker != blank -%}
        <p class="om-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="om-cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <span class="om-hero__cue om-kicker" aria-hidden="true">{{ section.settings.scroll_cue | escape }}</span>
    <div class="om-flash" aria-hidden="true"></div>
  </div>

  {%- if show_intro -%}
    <div class="om-intro" aria-hidden="true">
      <div class="om-intro__logo">
        {%- if section.settings.fallback_image != blank -%}
          {{ section.settings.fallback_image | image_url: width: 800 | image_tag: loading: 'eager', alt: '' }}
        {%- else -%}
          {{ 'logo.svg' | inline_asset_content }}
        {%- endif -%}
      </div>
      <span class="om-intro__count om-kicker"></span>
    </div>
  {%- endif -%}
</om-hero>

{% schema %}
{
  "name": "Origin hero",
  "tag": "section",
  "class": "om-section om-section--hero",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "Origin Manila" },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "In the trap we shine",
      "info": "Revealed under the headline as the logo pulls back."
    },
    {
      "type": "text",
      "id": "quote_accent",
      "label": "Quote word in blackletter",
      "default": "shine",
      "info": "One word from the quote. Leave empty for none."
    },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Manila · One of none" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "scroll_cue", "label": "Scroll cue", "default": "Scroll" },
    { "type": "header", "content": "Chrome logo" },
    {
      "type": "checkbox",
      "id": "enable_3d",
      "label": "3D chrome logo",
      "default": true,
      "info": "Loads after the page is ready, only on capable devices. Everyone else sees the chrome vector logo."
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Static logo image (optional)",
      "info": "Replaces the built-in vector logo for no-3D visitors."
    },
    { "type": "range", "id": "sparkles", "label": "Sparkles", "min": 0, "max": 80, "step": 5, "default": 40 },
    { "type": "range", "id": "tilt", "label": "Cursor tilt", "min": 0, "max": 100, "step": 10, "unit": "%", "default": 60 },
    { "type": "header", "content": "Scroll" },
    { "type": "range", "id": "length_desktop", "label": "Scroll length, desktop", "min": 160, "max": 360, "step": 10, "unit": "vh", "default": 280 },
    { "type": "range", "id": "length_mobile", "label": "Scroll length, mobile", "min": 120, "max": 300, "step": 10, "unit": "vh", "default": 220 },
    { "type": "header", "content": "Loading intro" },
    {
      "type": "checkbox",
      "id": "intro",
      "label": "Play intro",
      "default": true,
      "info": "The logo spins 360° once per visit; any tap or key skips it. Never plays in the editor or with reduced motion."
    },
    { "type": "range", "id": "intro_duration", "label": "Intro length", "min": 800, "max": 1500, "step": 100, "unit": "ms", "default": 1400 }
  ],
  "presets": [{ "name": "Origin hero" }]
}
{% endschema %}
