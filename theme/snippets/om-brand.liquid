{%- doc -%}
  Origin brand layer: display font, motion tokens and the global brand stylesheet.
  Render in <head> after 'theme-styles-variables' and 'color-palette' so its overrides win.

  @example
  {% render 'om-brand' %}
{%- enddoc -%}

{%- liquid
  assign om_display_font_url = 'om-archivo-expanded.woff2' | asset_url
-%}

{%- if settings.om_display_font -%}
  {{ om_display_font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endif -%}

{% style %}
  @font-face {
    font-family: 'OM Display';
    src: url('{{ om_display_font_url }}') format('woff2');
    font-weight: 800 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
      U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /*
    Local fallbacks scaled to Archivo Expanded's metrics, so the swap doesn't shift layout.
    Measured in the browser: Archivo Expanded 900 is 116.4% the width of Arial Black and 132.1% of
    Arial Bold; ascent 0.88em, descent 0.21em. Overrides are divided by size-adjust.
    Arial Black covers Windows/macOS; Arial Bold/Helvetica Bold covers iOS.
  */
  @font-face {
    font-family: 'OM Display Fallback';
    src: local('Arial Black'), local('ArialMT-Black'), local('Arial-Black');
    font-weight: 800 900;
    size-adjust: 116.4%;
    ascent-override: 75.6%;
    descent-override: 18%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'OM Display Fallback Bold';
    src: local('Arial Bold'), local('Arial-BoldMT'), local('Helvetica Bold'), local('Helvetica-Bold');
    font-weight: 800 900;
    size-adjust: 132.1%;
    ascent-override: 66.6%;
    descent-override: 15.9%;
    line-gap-override: 0%;
  }

  :root {
    --om-font-display: 'OM Display', 'OM Display Fallback', 'OM Display Fallback Bold',
      {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --om-stamp-color: {{ settings.om_claimed_color | default: '#ff3b47' }};

    --om-ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
    --om-ease-in: cubic-bezier(0.4, 0, 1, 1);
    --om-duration-micro: 120ms;
    --om-duration-ui: 240ms;
    --om-duration-ui-out: 160ms;
    --om-duration-sheen: 700ms;

    {%- if settings.om_display_font %}
      --font-heading--family: var(--om-font-display);
      --font-heading--weight: 900;
      --font-heading--style: normal;
    {%- endif %}
  }
{% endstyle %}

{{ 'om-brand.css' | asset_url | stylesheet_tag }}
