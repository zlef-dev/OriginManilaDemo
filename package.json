{
  "name": "origin-manila-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Spec Shopify theme for Origin Manila (Horizon fork). Only theme/ ships.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "shopify theme check --path theme",
    "dev": "shopify theme dev -e dev",
    "package": "shopify theme package --path theme && node tools/move-zip.mjs",
    "demo:fetch": "node demo/scripts/fetch-catalog.mjs",
    "demo:csv": "node demo/scripts/build-csv.mjs",
    "demo:verify": "node demo/scripts/verify-csv.mjs",
    "demo": "npm run demo:fetch && npm run demo:csv && npm run demo:verify",
    "demo:seed": "node demo/scripts/seed-store.mjs",
    "trace:logo": "node tools/trace-logo.mjs",
    "vendor": "node tools/vendor.mjs"
  },
  "devDependencies": {
    "@shopify/cli": "4.8.2",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "potrace": "2.1.8",
    "three": "0.186.1"
  }
}
